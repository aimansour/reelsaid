#!/usr/bin/env bash
set -euo pipefail

destination=${1:-.quality-models}
mkdir -p -- "$destination"

fetch() (
    local filename=$1 checksum=$2 url=$3 scratch
    cd -- "$destination"
    if [[ -f $filename ]] && printf '%s  %s\n' "$checksum" "$filename" | sha256sum --check --status; then
        return
    fi
    scratch=$(mktemp)
    trap 'rm -f -- "$scratch"' EXIT
    curl --fail --silent --show-error --location --retry 2 "$url" -o "$scratch"
    printf '%s  %s\n' "$checksum" "$scratch" | sha256sum --check --status
    mv -- "$scratch" "$filename"
)

fetch silero_vad.onnx 1a153a22f4509e292a94e67d6f9b85e8deb25b4988682b7e174c65279d8788e3 \
    https://raw.githubusercontent.com/snakers4/silero-vad/v6.2.3/src/silero_vad/data/silero_vad.onnx
fetch yamnet.tflite 4d8b4a53282dc83ef04e3e7dbc4fbc98082e34e44ed798e16c3a0cdd4c584faf \
    https://storage.googleapis.com/mediapipe-models/audio_classifier/yamnet/float32/1/yamnet.tflite
