#!/usr/bin/env bash
set -euo pipefail

printf '%s\n' 'REELSAID_PRIVATE_CANARY_5f2499a3'
printf '%s\n' 'REELSAID_PRIVATE_CANARY_5f2499a3' >&2
case "$1" in
    pass)
        npm exec --yes --package=apify-cli@1.11.0 -- apify actors ls --my --limit 1 --json
        ;;
    run)
        npm exec --yes --package=apify-cli@1.11.0 -- bash scripts/probe-retrieval.sh
        ;;
    fail)
        exit 1
        ;;
    *)
        exit 2
        ;;
esac
