#!/usr/bin/env bash
set -euo pipefail

printf '%s\n' 'REELSAID_PRIVATE_CANARY_5f2499a3'
printf '%s\n' 'REELSAID_PRIVATE_CANARY_5f2499a3' >&2
case "$1" in
    pass)
        npm exec --yes --package=apify-cli@1.11.0 -- apify actors ls --my --limit 1 --json
        ;;
    run)
        if ! command -v uv >/dev/null; then
            uv_environment=$(mktemp -d)
            trap 'rm -rf -- "$uv_environment"' EXIT
            python3 -m venv "$uv_environment"
            "$uv_environment/bin/pip" install --disable-pip-version-check uv==0.12.23
            export PATH="$uv_environment/bin:$PATH"
        fi
        if ! command -v ffprobe >/dev/null || ! command -v ffmpeg >/dev/null; then
            sudo apt-get update -q
            sudo apt-get install -y --no-install-recommends ffmpeg
        fi
        ./scripts/verify all
        npm exec --yes --package=apify-cli@1.11.0 -- apify validate-schema .actor/input_schema.json
        ;;
    cloud)
        npm exec --yes --package=apify-cli@1.11.0 -- python3 scripts/probe-transcription.py adapter
        ;;
    fail)
        exit 1
        ;;
    *)
        exit 2
        ;;
esac
