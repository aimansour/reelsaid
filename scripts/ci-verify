#!/usr/bin/env bash
set -euo pipefail

printf '%s\n' 'REELSAID_PRIVATE_CANARY_5f2499a3'
printf '%s\n' 'REELSAID_PRIVATE_CANARY_5f2499a3' >&2
ensure_uv() {
    if ! command -v uv >/dev/null; then
        uv_environment=$(mktemp -d)
        trap 'rm -rf -- "$uv_environment"' EXIT
        python3 -m venv "$uv_environment"
        "$uv_environment/bin/pip" install --disable-pip-version-check uv==0.12.23
        export PATH="$uv_environment/bin:$PATH"
    fi
}

case "$1" in
    pass)
        npm exec --yes --package=apify-cli@1.11.0 -- apify actors ls --my --limit 1 --json
        ;;
    run)
        ensure_uv
        if ! command -v ffprobe >/dev/null || ! command -v ffmpeg >/dev/null; then
            sudo apt-get update -q
            sudo apt-get install -y --no-install-recommends ffmpeg
        fi
        ./scripts/verify all
        npm exec --yes --package=apify-cli@1.11.0 -- apify validate-schema
        ;;
    cloud)
        npm exec --yes --package=apify-cli@1.11.0 -- bash scripts/probe-actor.sh
        ;;
    measure)
        npm exec --yes --package=apify-cli@1.11.0 -- bash -c 'bash scripts/deploy-actor.sh && python3 scripts/benchmark-reelsaid.py'
        ;;
    account)
        npm exec --yes --package=apify-cli@1.11.0 -- bash scripts/probe-billing.sh
        ;;
    package)
        : "${PACKAGE_ROOT:?The public checkout is required}"
        ensure_uv
        ./scripts/verify package
        bash scripts/probe-package.sh
        ;;
    release)
        : "${PACKAGE_ROOT:?The public checkout is required}"
        ensure_uv
        ./scripts/verify release
        ./scripts/verify package
        npm exec --yes --package=apify-cli@1.11.0 -- bash scripts/release-actor.sh "${@:2}"
        ;;
    periodic)
        npm exec --yes --package=apify-cli@1.11.0 -- bash scripts/release-actor.sh periodic
        ;;
    runner-health)
        ensure_uv
        if ! command -v ffprobe >/dev/null || ! command -v ffmpeg >/dev/null; then
            sudo apt-get update -q
            sudo apt-get install -y --no-install-recommends ffmpeg
        fi
        bash scripts/install-quality-models
        npm exec --yes --package=apify-cli@1.11.0 -- bash -c './scripts/verify runner && bash scripts/check-runner.sh batch'
        ;;
    compare)
        python3 -m unittest discover -s tests/automation -p test_market_benchmark.py
        case "${2:-contract}" in
            standby-probe)
                npm exec --yes --package=apify-cli@1.11.0 -- bash scripts/probe-standby.sh ;;
            standby-multi)
                npm exec --yes --package=apify-cli@1.11.0 -- bash scripts/probe-standby.sh MULTI_TENANT ;;
            retrieval-timing)
                npm exec --yes --package=apify-cli@1.11.0 -- bash scripts/probe-discovery.sh '{"measureGuestBootstrap":true}' ;;
            timing|startup|cached-base|lean-media|timestamps|native)
                npm exec --yes --package=apify-cli@1.11.0 -- bash scripts/probe-launch-timing.sh "$PACKAGE_ROOT" "$2" ;;
            *)
                npm exec --yes --package=apify-cli@1.11.0 -- python3 scripts/benchmark-market.py --launch "${2:-contract}" ;;
        esac
        ;;
    fail)
        exit 1
        ;;
    *)
        exit 2
        ;;
esac
