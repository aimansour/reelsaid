{
  "openapi": "3.0.3",
  "info": {
    "title": "ReelSaid Standby Verification",
    "version": "0.1.0",
    "description": "Private verification of the Apify gateway, readiness and request accounting."
  },
  "security": [{"apifyToken": []}],
  "paths": {
    "/": {
      "get": {
        "operationId": "readiness",
        "summary": "Check server readiness",
        "parameters": [{
          "in": "header",
          "name": "X-Apify-Container-Server-Readiness-Probe",
          "schema": {"type": "string"}
        }],
        "responses": {
          "200": {
            "description": "The server is ready.",
            "content": {
              "text/plain": {"schema": {"type": "string", "example": "OK"}},
              "application/json": {"schema": {"type": "object", "example": {"status": "ready"}}}
            }
          }
        }
      }
    },
    "/probe": {
      "post": {
        "operationId": "observe",
        "summary": "Check the current request context",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["mode"],
                "properties": {
                  "mode": {"type": "string", "enum": ["observe", "zero", "charge", "store"]},
                  "maxTotalChargeUsd": {"type": "number", "minimum": 0},
                  "usePlatformRequestId": {"type": "boolean"}
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sanitized platform observations.",
            "content": {"application/json": {"schema": {"type": "object"}}}
          },
          "400": {"description": "The request JSON or parameters are invalid."},
          "401": {"description": "An Apify API token is required."},
          "403": {"description": "The token cannot access this private Actor."},
          "415": {"description": "Use application/json."},
          "503": {"description": "Caller-scoped storage could not be verified."}
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apifyToken": {"type": "http", "scheme": "bearer", "description": "Use an authorized Apify API token."}
    }
  }
}
